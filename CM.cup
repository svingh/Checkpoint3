/* ----------------------Preliminary Declarations Section--------------------*/
   
import absyn.*;
   
/* Parser code to change the way the parser reports errors (include
   line and column number of the error). */
parser code {:
    
    /* Change the method report_error so it will display the line and
       column of where the error occurred in the input as well as the
       reason for the error which is passed into the method in the
       String 'message'. */
    public void report_error(String message, Object info) {
   
        /* Create a StringBuffer called 'm' with the string 'Error' in it. */
        StringBuffer m = new StringBuffer("Error");
   
        /* Check if the information passed to the method is the same
           type as the type java_cup.runtime.Symbol. */
        if (info instanceof java_cup.runtime.Symbol) {
            /* Declare a java_cup.runtime.Symbol object 's' with the
               information in the object info that is being typecasted
               as a java_cup.runtime.Symbol object. */
            java_cup.runtime.Symbol s = ((java_cup.runtime.Symbol) info);
   
            /* Check if the line number in the input is greater or
               equal to zero. */
            if (s.left >= 0) {                
                /* Add to the end of the StringBuffer error message
                   the line number of the error in the input. */
                m.append(" in line "+(s.left+1));   
                /* Check if the column number in the input is greater
                   or equal to zero. */
                if (s.right >= 0)                    
                    /* Add to the end of the StringBuffer error message
                       the column number of the error in the input. */
                    m.append(", column "+(s.right+1));
            }
        }
   
        /* Add to the end of the StringBuffer error message created in
           this method the message that was passed into this method. */
        m.append(" : "+message);
   
        /* Print the contents of the StringBuffer 'm', which contains
           an error message, out on a line. */
        System.err.println(m);
    }
   
    /* Change the method report_fatal_error so when it reports a fatal
       error it will display the line and column number of where the
       fatal error occurred in the input as well as the reason for the
       fatal error which is passed into the method in the object
       'message' and then exit.*/
    public void report_fatal_error(String message, Object info) {
        report_error(message, info);
        System.exit(1);
    }

    /* Assume true at the start, but set to false with parsing errors */
    public static boolean valid = true;

:};
   
   
/* -----------------Terminals and Non-Terminals Definitions------------------ */

terminal String TRUTH, NUM, ID;
terminal BOOL, ELSE, IF, INT, RETURN, VOID, WHILE;
terminal LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET;
terminal LT, LE, GT, GE, EQ, NE, PLUS, MINUS, TIMES, OVER, NOT, OR, AND, ASSIGN, SEMI, COMMA;
terminal ERROR;

non terminal DecList program, declarationList;
non terminal Dec declaration, funPrototype;
non terminal VarDec varDeclaration, param;
non terminal FunctionDec functionDeclaration;
non terminal NameTy typeSpecifier;
non terminal VarDecList params, paramList, localDeclarations;
non terminal ExpList args, argList, statementList;
non terminal Exp expression, compoundStatement, expressionStatement, iterationStatement, selectionStatement, statement, returnStatement;
non terminal Var var;

precedence nonassoc LT, GT, LE, GE, NE, EQ;
precedence left AND, OR;
precedence left TIMES, OVER;
precedence left PLUS, MINUS;
precedence left ELSE, SEMI, ID;
/* -----------------------------Grammar Rules------------------------------ */
start with program;

program  ::= declarationList:s
            {: RESULT = s; :}
         ;

declarationList ::= declarationList:s declaration:d
            {:
                DecList current = s;
                if (current != null) {
                    while (current.tail != null) {
                        current = current.tail;
                    }
                    current.tail = new DecList(d, null);
                    RESULT = s;
                } else {
                    RESULT = new DecList(d, null);
                }
            :}
         | declaration:d
            {:
                RESULT = new DecList(d, null);
            :}
         ;

declaration ::= varDeclaration:vd
            {:
                RESULT = vd;
            :}
         | functionDeclaration:fd
            {:
                RESULT = fd;
            :}
         | funPrototype:fp
            {:
                RESULT = fp;
            :}
         ;

varDeclaration ::= typeSpecifier:ts ID:id SEMI
                  {:
                      RESULT = new SimpleDec(tsleft, tsright, ts, id);
                  :}
               | typeSpecifier:ts ID:id LBRACKET NUM:n RBRACKET SEMI
                  {:
                      RESULT = new ArrayDec(tsleft, tsright, ts, id, Integer.parseInt(n));
                  :}
               | typeSpecifier:ts ID:id LBRACKET error:e SEMI
                  {:
                      parser.report_error(
                          "Array size missing at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new SimpleDec(tsleft, tsright, ts, null);
                  :}
               | typeSpecifier:ts ID:id LBRACKET NUM:n error:e SEMI
                  {:
                      parser.report_error(
                          "Missing closing bracket at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new SimpleDec(tsleft, tsright, ts, null);
                  :}
               | typeSpecifier:ts ID:id error:e RBRACKET
                  {:
                      parser.report_error(
                          "Missing opening bracket at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new SimpleDec(tsleft, tsright, ts, null);
                  :}
               | typeSpecifier:ts ID:id error:e SEMI
                  {:
                      parser.report_error(
                          "Invalid syntax in declaration at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new SimpleDec(tsleft, tsright, ts, null);
                  :}
               | typeSpecifier:ts error:e SEMI
                  {:
                      parser.report_error(
                          "Invalid identifier at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new SimpleDec(tsleft, tsright, ts, null);
                  :}
               | error:e SEMI
                  {:
                      parser.report_error(
                          "Invalid type declaration at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new SimpleDec(
                          eleft, 0, new NameTy(eleft, 0, NameTy.NULL), null
                      );
                  :}
               ;

typeSpecifier  ::= BOOL:b
                  {: RESULT = new NameTy(bleft, bright, NameTy.BOOL); :}
               | INT:i
                  {: RESULT = new NameTy(ileft, iright, NameTy.INT); :}
               | VOID:v
                  {: RESULT = new NameTy(vleft, vright, NameTy.VOID); :}
               ;

functionDeclaration ::= typeSpecifier:ts ID:id LPAREN params:ps RPAREN compoundStatement:cs
                  {:
                      RESULT = new FunctionDec(tsleft, tsright, ts, id, ps, cs);
                  :}
               | typeSpecifier:ts ID:id LPAREN error:e compoundStatement:cs
                  {:
                      parser.report_error(
                          "Invalid parameters - use 'void' for none at line " + (eleft + 1) + ", column " + (eright + 1), e
                      );
                      RESULT = new FunctionDec(tsleft, tsright, ts, id, null, cs);
                  :}
               | typeSpecifier:ts ID:id error:e compoundStatement:cs
                  {:
                      parser.report_error(
                          "Missing '(' in function declaration at line " + (eleft + 1) + ", column " + (eright + 1), e
                      );
                      RESULT = new FunctionDec(tsleft, tsright, ts, id, null, cs);
                  :}
               | typeSpecifier:ts ID:id LPAREN params:ps error:e compoundStatement:cs
                  {:
                      parser.report_error(
                          "Missing ')' in function declaration at line " + (eleft + 1) + ", column " + (eright + 1), e
                      );
                      RESULT = new FunctionDec(tsleft, tsright, ts, id, null, cs);
                  :}
               | typeSpecifier:ts error:e compoundStatement:cs
                  {:
                      parser.report_error(
                          "Missing function name at line " + (eleft + 1) + ", column " + (eright + 1), e
                      );
                      RESULT = new FunctionDec(tsleft, tsright, ts, null, null, cs);
                  :}
               | error:e ID:id LPAREN RPAREN compoundStatement:cs
                  {:
                      parser.report_error(
                          "Missing return type at line " + (eleft + 1) + ", column " + (eright + 1), e
                      );
                      RESULT = new FunctionDec(
                          eleft, 0, new NameTy(eleft, 0, NameTy.NULL), id, null, cs
                      );
                  :}
               ;


funPrototype ::= typeSpecifier:ts ID:id LPAREN params:ps RPAREN SEMI
                  {:
                      RESULT = new FunctionDec(tsleft, tsright, ts, id, ps, null);
                  :}
               | typeSpecifier:ts ID:id LPAREN params:ps RPAREN error:e SEMI
                  {:
                      parser.report_error("Expected semicolon at line " + (eleft + 1) + ", column " + (eright + 1), e);
                  :}
               | typeSpecifier:ts ID:id error:e params:ps RPAREN SEMI
                  {:
                      parser.report_error("Expected '(' before function parameters at line " + (eleft + 1) + ", column " + (eright + 1), e);
                  :}
               | typeSpecifier:ts ID:id LPAREN params:ps error:e SEMI
                  {:
                      parser.report_error("Expected ')' to close parameter list at line " + (eleft + 1) + ", column " + (eright + 1), e);
                  :}
               | typeSpecifier:ts ID:id LPAREN error:e RPAREN SEMI
                  {:
                      parser.report_error(
                          "Invalid parameters - use 'void' for none at line " + (eleft + 1) + ", column " + (eright + 1), e
                      ); 
                      RESULT = new FunctionDec(tsleft, tsright, ts, id, null, null);
                  :}
               ;


params ::= paramList:pl
            {:
                RESULT = pl;
            :}
         | VOID
            {:
                RESULT = null;
            :}
         ;

paramList ::= paramList:pl COMMA param:p
               {:
                   VarDecList current = pl;
                   while (current.tail != null) {
                       current = current.tail;
                   }
                   current.tail = new VarDecList(p, null);
                   RESULT = pl;
               :}
            | param:p
               {:
                   RESULT = new VarDecList(p, null);
               :}
            ;

param ::= typeSpecifier:ts ID:id
            {:
                RESULT = new SimpleDec(tsleft, tsright, ts, id);
            :}
         | typeSpecifier:ts ID:id LBRACKET RBRACKET
            {:
                RESULT = new ArrayDec(tsleft, tsright, ts, id, 0);
            :}
         ;

compoundStatement ::= LBRACE localDeclarations:ld statementList:sl RBRACE
                     {:
                         RESULT = new CompoundExp(ldleft, ldright, ld, sl);
                     :}
                  ;

localDeclarations ::= localDeclarations:ld varDeclaration:vd
                     {:
                        if (ld == null) {
                            RESULT = new VarDecList(vd, null);
                        } else {
                            ld.appendVarDec(vd);
                            RESULT = ld;
                        }
                     :}
                  |
                     {:
                        RESULT = null;
                     :}
                  ;

statementList ::= statementList:sl statement:s
                  {:
                     if (sl == null) {
                         RESULT = new ExpList(s, null);
                     } else {
                         sl.appendExp(s);
                         RESULT = sl;
                     }
                  :}
               |
                  {:
                     RESULT = null;
                  :}
               ;


statement   ::= expressionStatement:es
               {: RESULT = es; :}
            | compoundStatement:cs
               {: RESULT = cs; :}
            | selectionStatement:ss
               {: RESULT = ss; :}
            | iterationStatement:is
               {: RESULT = is; :}
            | returnStatement:rs
               {: RESULT = rs; :}
            ;

expressionStatement  ::= expression:e SEMI
                        {: RESULT = e; :}
                     | SEMI
                     ;

selectionStatement ::= IF:i LPAREN expression:e RPAREN statement:s
            {:
               RESULT = new IfExp(ileft, iright, e, s, null); // Ensure elsee is null when no else clause
            :}
            | IF:i LPAREN expression:e RPAREN statement:s1 ELSE statement:s2
            {:
               RESULT = new IfExp(ileft, iright, e, s1, s2);
            :}
            | IF:i LPAREN error:e RPAREN statement:s
            {:
               parser.report_error("Invalid conditional expression at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, null, s, null); // Set elsee to null instead of NilExp
            :}
            | IF:i LPAREN error:e expression:exp RPAREN statement:s1 ELSE statement:s2
            {:
               parser.report_error("Malformed condition detected at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, exp, s1, s2);
            :}
            | IF:i LPAREN expression:exp RPAREN error:e statement:s1 ELSE statement:s2
            {:
               parser.report_error("Unexpected syntax after condition at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, exp, s1, s2);
            :}
            | IF:i LPAREN expression:exp RPAREN statement:s1 ELSE error:e statement:s2
            {:
               parser.report_error("Syntax error following 'else' at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, exp, s1, s2);
            :}
            | IF:i LPAREN error:e RPAREN statement:s1 ELSE statement:s2
            {:
               parser.report_error("Invalid expression in condition at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, null, s1, s2);
            :}
            | IF:i LPAREN expression:exp RPAREN error:e statement:s
            {:
               parser.report_error("Syntax issue after condition at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, exp, s, null); // Ensure elsee is null
            :}
            | IF:i error:e LPAREN expression:exp RPAREN statement:s
            {:
               parser.report_error("Missing opening parenthesis '(' at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new IfExp(ileft, iright, exp, s, null); // Ensure elsee is null
            :}
         ;



iterationStatement ::= WHILE:w LPAREN expression:e RPAREN statement:s
            {:
               RESULT = new WhileExp(wleft, wright, e, s);
            :}
         | WHILE:w LPAREN error:e RPAREN statement:s
            {:
               parser.report_error("Invalid condition in loop at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new WhileExp(wleft, wright, null, s);
            :}
         | WHILE:w error:e LPAREN expression:exp RPAREN statement:s
            {:
               parser.report_error("Expected '(' before condition at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new WhileExp(wleft, wright, exp, s);
            :}
         | WHILE:w LPAREN expression:exp RPAREN error:e statement:s
            {:
               parser.report_error("Unexpected token after condition at line " + (eleft + 1) + ", column " + (eright + 1), e);
               RESULT = new WhileExp(wleft, wright, exp, s);
            :}
         ;


returnStatement   ::= RETURN:r SEMI
                        {: RESULT = new ReturnExp(rleft, rright, new NilExp(rleft, rright)); :}
                  | RETURN:r expression:e SEMI
                     {: RESULT = new ReturnExp(rleft, rright, e); :}
                  | RETURN:r expression:exp error:e SEMI
                     {: parser.report_error("Invalid return expression before ';' in line " + (eleft + 1) + " at column " + (eright + 1) + "\n", e); 
                        RESULT = new ReturnExp(rleft, rright, exp);
                     :}
                  | RETURN:r error:e SEMI
                     {: parser.report_error("Invalid return expression in line " + (rleft + 1) + " at column " + (rright + 1) + ": missing semicolon.\n", null); 
                        RESULT = new ReturnExp(rleft, rright, new NilExp(rleft, rright));
                     :}
                  | RETURN:r expression:e error:e2 SEMI
                     {: parser.report_error("Invalid token in return expression in line " + (e2left + 1) + " at column " + (e2right + 1) + ".\n", e2);
                        RESULT = new ReturnExp(rleft, rright, e);
                     :}
                  | RETURN:r LPAREN expression:e RPAREN SEMI
                     {: RESULT = new ReturnExp(rleft, rright, e); :}
                  | RETURN:r LPAREN error:e RPAREN SEMI
                     {: parser.report_error("Invalid return expression in parentheses in line " + (eleft + 1) + " at column " + (eright + 1) + ".\n", e);
                        RESULT = new ReturnExp(rleft, rright, new NilExp(rleft, rright));
                     :}
                  | RETURN:r SEMI error:e
                     {: parser.report_error("Unexpected token after return statement in line " + (rleft + 1) + " at column " + (rright + 1) + ".\n", e);
                        RESULT = new ReturnExp(rleft, rright, new NilExp(rleft, rright));
                     :}
                  | RETURN:r expression:e SEMI error:e2
                     {: parser.report_error("Unexpected token after valid return expression in line " + (e2left + 1) + " at column " + (e2right + 1) + ".\n", e2);
                        RESULT = new ReturnExp(rleft, rright, e);
                     :}
                  | RETURN:r error:e
                     {: parser.report_error("Invalid return statement in line " + (rleft + 1) + " at column " + (rright + 1) + ".\n", e);
                        RESULT = new ReturnExp(rleft, rright, new NilExp(rleft, rright));
                     :}
                  ;



expression ::= var:v ASSIGN expression:e
            {:
               RESULT = new AssignExp(vleft, vright, new VarExp(vleft, vright, v), e);
            :}
         | expression:x1 PLUS expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.PLUS, x2);
            :}
         | expression:x1 MINUS expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.MINUS, x2);
            :}
         | expression:x1 TIMES expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.TIMES, x2);
            :}
         | expression:x1 OVER expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.OVER, x2);
            :}
         | expression:x1 EQ expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.EQ, x2);
            :}
         | expression:x1 NE expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.NE, x2);
            :}
         | expression:x1 LT expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.LT, x2);
            :}
         | expression:x1 LE expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.LE, x2);
            :}
         | expression:x1 GT expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.GT, x2);
            :}
         | expression:x1 GE expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.GE, x2);
            :}
         | NOT:n expression:e
            {:
               RESULT = new OpExp(nleft, nright, new NilExp(nleft, nright), OpExp.NOT, e);
            :}
         | expression:x1 AND expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.AND, x2);
            :}
         | expression:x1 OR expression:x2
            {:
               RESULT = new OpExp(x1left, x1right, x1, OpExp.OR, x2);
            :}
         | MINUS:m expression:e
            {:
               RESULT = new OpExp(mleft, mright, new NilExp(mleft, mright), OpExp.UMINUS, e);
            :}
         | LPAREN expression:e RPAREN
            {:
               RESULT = e;
            :}
         | var:v
            {:
               RESULT = new VarExp(vleft, vright, v);
            :}
         | ID:id LPAREN args:a RPAREN
            {:
               RESULT = new CallExp(idleft, idright, id, a);
            :}
         | ID:id LPAREN RPAREN
            {:
               RESULT = new CallExp(idleft, idright, id, null);
            :}
         | NUM:n
            {:
               RESULT = new IntExp(nleft, nright, Integer.parseInt(n));
            :}
         | TRUTH:t
            {:
               RESULT = new BoolExp(tleft, tright, Boolean.parseBoolean(t));
            :}
         ;

var ::= ID:identifier
         {:
            RESULT = new SimpleVar(identifierleft, identifierright, identifier);
         :}
      | ID:identifier LBRACKET expression:exp RBRACKET
         {:
            RESULT = new IndexVar(identifierleft, identifierright, identifier, exp);
         :}
      ;

args ::=  argList:al
         {:
            RESULT = al;
         :}
      ;

argList ::= argList:al COMMA expression:e
         {:
            ExpList temp = al;
            while (temp.tail != null)
               temp = temp.tail;
            temp.tail = new ExpList(e, null);
            RESULT = al;
         :}
      | expression:e
         {:
            RESULT = new ExpList(e, null);
         :}
      ;